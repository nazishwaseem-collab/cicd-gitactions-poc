<?xml version="1.0" encoding="UTF-8"?>
														 
																
<settings xmlns="http://maven.apache.org/SETTINGS/1.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/SETTINGS/1.0.0 https://maven.apache.org/xsd/settings-1.0.0.xsd">
  
	<pluginGroups>
		<pluginGroup>org.mule.tools</pluginGroup>
	</pluginGroups>
  
	<servers>
		<!--  Auth for Anypoint Exchange dependency resolution  -->
		<server>
			<id>anypoint-exchange-v3</id>
			<username>~~~Client~~~</username>
			<password>${client.id}~?~${client.secret}</password>
		</server>
	
		<!--  Auth for publishing to Exchange  -->
		<server>
			<id>Repository</id>
			<username>~~~Client~~~</username>
			<password>${client.id}~?~${client.secret}</password>
		</server>
	
		<!--  Nexus EE Releases  -->
		<server>
			<id>nexus</id>
			<username>${env.NEXUS_USERNAME}</username>
			<password>${env.NEXUS_PASSWORD}</password>
		</server>
	
		<!--  Nexus EE Snapshots  -->
		<server>
			<id>nexus-snapshots</id>
			<username>${env.NEXUS_USERNAME}</username>
			<password>${env.NEXUS_PASSWORD}</password>
		</server>
	</servers>
  
	<profiles>
		<!--  MuleSoft Repositories Profile  -->
		<profile>
			<id>mulesoft</id>
			<repositories>
				<repository>
					<id>anypoint-exchange-v3</id>
					<url>https://maven.anypoint.mulesoft.com/api/v3/maven</url>
				</repository>
				<repository>
					<id>mulesoft-releases</id>
					<url>https://repository.mulesoft.org/releases/</url>
				</repository>
				<repository>
					<id>nexus</id>
					<url>https://repository.mulesoft.org/nexus-ee/content/repositories/releases-ee</url>
				</repository>
				<repository>
					<id>nexus-snapshots</id>
					<url>https://repository.mulesoft.org/nexus-ee/content/repositories/snapshots-ee</url>
				</repository>
			</repositories>
			<pluginRepositories>
				<pluginRepository>
					<id>mulesoft-releases</id>
					<url>https://repository.mulesoft.org/releases/</url>
				</pluginRepository>
				<pluginRepository>
					<id>nexus</id>
					<url>https://repository.mulesoft.org/nexus-ee/content/repositories/releases-ee</url>
				</pluginRepository>
			</pluginRepositories>
		</profile>
	
		<!--  ==========================================  -->
		<!--      ENVIRONMENT-SPECIFIC PROFILES           -->
		<!--  ==========================================  -->
	
		<!--  DEV Profile (matches config-secure-DEV.yaml)  -->
		<profile>
			<id>DEV</id>
			<properties>
				<env>DEV</env>
				<anypoint.environment>Development</anypoint.environment>
				<app.name.prefix>bosdev</app.name.prefix>
				<cloudhub.region>Cloudhub-US-East-2</cloudhub.region>
				<cloudhub.domain.suffix>us-e1.cloudhub.io</cloudhub.domain.suffix>
				<!--  DEV-specific deployment config  -->
				<cloudhub.replicas>1</cloudhub.replicas>
				<cloudhub.vcores>0.1</cloudhub.vcores>
				<!--  API Manager properties  -->
				<api.manager.endpoint.uri>https://${app.name.prefix}-${project.artifactId}.${cloudhub.domain.suffix}</api.manager.endpoint.uri>
				<api.manager.deployment.type>cloudhub2</api.manager.deployment.type>
				<api.manager.path>/</api.manager.path>
				<api.manager.scheme>https</api.manager.scheme>
				<api.manager.port>443</api.manager.port>
			</properties>
		</profile>
	
		<!--  UAT Profile (matches config-secure-UAT.yaml)  -->
		<profile>
			<id>UAT</id>
			<properties>
				<env>UAT</env>
				<anypoint.environment>UAT</anypoint.environment>
				<app.name.prefix>bosuat</app.name.prefix>
				<cloudhub.region>Cloudhub-US-East-2</cloudhub.region>
				<cloudhub.domain.suffix>us-e1.cloudhub.io</cloudhub.domain.suffix>
				<!--  UAT-specific deployment config  -->
				<cloudhub.replicas>1</cloudhub.replicas>
				<cloudhub.vcores>0.1</cloudhub.vcores>
				<!-- Add this for Maven Release Plugin -->
				<project.scm.url>https://github.com/nazishwaseem-collab/cicd-gitactions-poc</project.scm.url>
				<!--  API Manager properties  -->
				<api.manager.endpoint.uri>https://${app.name.prefix}-${project.artifactId}.${cloudhub.domain.suffix}</api.manager.endpoint.uri>
				<api.manager.deployment.type>cloudhub2</api.manager.deployment.type>
				<api.manager.path>/</api.manager.path>
				<api.manager.scheme>https</api.manager.scheme>
				<api.manager.port>443</api.manager.port>
			</properties>
		</profile>
	
		<!--  PROD Profile (matches config-secure-PROD.yaml)  -->
		<profile>
			<id>PROD</id>
			<properties>
				<env>PROD</env>
				<anypoint.environment>Production</anypoint.environment>
				<app.name.prefix>bos</app.name.prefix>
				<cloudhub.region>Cloudhub-US-East-2</cloudhub.region>
				<cloudhub.domain.suffix>us-e1.cloudhub.io</cloudhub.domain.suffix>
				<!--  PROD-specific deployment config  -->
				<cloudhub.replicas>1</cloudhub.replicas>
				<cloudhub.vcores>0.1</cloudhub.vcores>
				<!--  API Manager properties  -->
				<api.manager.endpoint.uri>https://${app.name.prefix}-${project.artifactId}.${cloudhub.domain.suffix}</api.manager.endpoint.uri>
				<api.manager.deployment.type>cloudhub2</api.manager.deployment.type>
				<api.manager.path>/</api.manager.path>
				<api.manager.scheme>https</api.manager.scheme>
				<api.manager.port>443</api.manager.port>
			</properties>
		</profile>
	</profiles>
  
	<activeProfiles>
		<activeProfile>mulesoft</activeProfile>
	</activeProfiles>
</settings>